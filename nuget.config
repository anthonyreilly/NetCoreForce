<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore only from nuget.org, regardless of any feeds in machine or user level NuGet config.
  Packages published from this repo are built locally, so an extra feed could otherwise supply a substitute package (dependency confusion).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
